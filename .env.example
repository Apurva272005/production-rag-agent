# Copy to .env and fill in values

# OpenRouter API key for LLM completions (required to use /ask endpoint)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Qdrant Cloud (optional). If using the local docker-compose qdrant, leave these blank.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_db

# Inngest dev server event URL (default listens at 8288 for the dev CLI)
INNGEST_DEV_EVENT_URL=http://127.0.0.1:8288/e/local

# FastAPI base URL used by the Streamlit frontend
FASTAPI_BASE_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8501

# Inngest signing key (set this only for production)
INNGEST_SIGNING_KEY=

# Clerk authentication
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8000,http://127.0.0.1:8501
CLERK_JWT_TEMPLATE=rag-api
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
STREAMLIT_URL=http://127.0.0.1:8501
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8501
STUDENT_DOMAINS=charusat.edu.in,edu.charusat.org
FACULTY_DOMAINS=charusat.org,charusat.ac.in
ADMIN_EMAILS=replace-with-admin@charusat.org
ADMIN_EXCEPTION_EMAILS=apurvaankhiwala27@gmail.com
CLERK_ROLE_CACHE_TTL_SECONDS=60
QUERY_RATE_LIMIT_PER_MINUTE=30
# Optional custom CA bundle. TLS verification remains enabled.
# SSL_CERT_FILE=
